# Environment variables template for CrowdGuard AI
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=crowdguard_super_secret_jwt_and_session_key_2026
PORT=5000
HOST=0.0.0.0

# System mode
DEMO_MODE=true

# MongoDB Configuration (Prepared for Phase 2)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=crowdguard_ai

# AI Models (Prepared for upcoming phases)
PERSON_MODEL_PATH=models/person/yolo11n.pt
WEAPON_MODEL_PATH=models/weapon/weapon_detector.pt
VIOLENCE_MODEL_PATH=models/violence/action_model.pt

# Thresholds & Detection Tuning
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.50
RUNNING_VELOCITY_THRESHOLD=18.0
LOITERING_TIME_THRESHOLD_SEC=60
LOITERING_MAX_DISPLACEMENT=30.0
CROWD_DENSITY_NORMAL=10
CROWD_DENSITY_MODERATE=20
